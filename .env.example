# Copy to .env and fill in. Generate the three secrets with:
#   flask --app run gen-keys

FLASK_ENV=development

# Production must be Postgres. SQLite is dev/test only — it has no
# SKIP LOCKED, so the timeout sweep cannot run concurrently and safely.
DATABASE_URL=postgresql://swapguard:password@localhost:5432/swapguard

SECRET_KEY=
PHONE_PEPPER=
PHONE_ENCRYPTION_KEY=

CONSENT_TIMEOUT_SECONDS=120
MAX_PIN_ATTEMPTS=3
AGENT_SWAP_RATE_LIMIT=20
AGENT_SWAP_RATE_WINDOW_SECONDS=3600

# Leave AT_API_KEY empty to run fully simulated (no external account needed).
AT_USERNAME=sandbox
AT_API_KEY=
USSD_SERVICE_CODE=*384*88#

# Comma-separated CIDRs allowed to POST /ussd. Get the real ranges from
# Africa's Talking support before going live. Empty = check disabled (dev).
AT_ALLOWED_IPS=
